# Copiar a .env.local y rellenar. .env.local está en .gitignore.
#
# ATENCIÓN: este repositorio es PÚBLICO. Nunca commitear claves reales.
# La clave de servicio (service_role / secret) NO debe salir del servidor bajo ninguna
# circunstancia: salta RLS por completo.

# --- Supabase ---
SUPABASE_URL=https://mhqyonldsvlyxebdmjse.supabase.co
SUPABASE_PROJECT_REF=mhqyonldsvlyxebdmjse

# Clave pública, usada por el frontend. Viaja en el bundle del navegador por diseño;
# lo que protege los datos es RLS, no el secreto de esta clave.
SUPABASE_ANON_KEY=

# Solo en el servidor (services/api). Salta RLS.
SUPABASE_SERVICE_KEY=

# --- Edge agent ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=frigate

# Mapa cámara -> dirección. Debe coincidir con los nombres en infra/edge/frigate/config.yml
# y con la tabla `cameras`.
CAMERA_DIRECTIONS=porteria_entrada:in,porteria_salida:out

API_BASE_URL=http://localhost:8000
API_INGEST_TOKEN=
OUTBOX_PATH=services/edge_agent/outbox.db
DEDUP_WINDOW_SECONDS=90

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
